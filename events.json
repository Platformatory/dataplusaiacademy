---
layout: null
---
[
{% for event in site.events %}
  {
    "slug": {{ event.slug | jsonify }},
    "badge": {{ event.badge | jsonify }},
    "title": {{ event.title | jsonify }},
    "short_title": {{ event.short_title | jsonify }},
    "topics": {{ event.topics | jsonify }},
    "format": {{ event.format | jsonify }},
    "location": {{ event.location | jsonify }},
    "price_label": {{ event.price_label | jsonify }},
    "time_label": {{ event.time_label | jsonify }},
    "sessions": {{ event.sessions | jsonify }},
    "url": {{ event.detail_url | relative_url | jsonify }},
    "cta_label": {{ event.cta_label | jsonify }},
    "form_url": {{ event.form_url | jsonify }},
    "form_embed_url": {{ event.form_embed_url | jsonify }},
    "form_height": {{ event.form_height | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
